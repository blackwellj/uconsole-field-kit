# HackerGadgets AIO V2 boot state
AIO_GPS_ON_BOOT=1
AIO_SDR_ON_BOOT=1
AIO_USB_ON_BOOT=1
AIO_LORA_ON_BOOT=1

# meshcore, meshtastic or off
DEFAULT_MESH_MODE=meshcore

# Pinned MeshDash release
MESHDASH_VERSION=R3.1.2
MESHDASH_ZIP_URL=https://meshdash.co.uk/versions/R3.1.2/mesh-dash.zip

# Known uConsole integration repository
MESHCORE_REPOSITORY=https://github.com/cwill747/meshcore-uconsole.git
MESHCORE_BRANCH=main
